DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/filmory
SECRET_KEY=your-jwt-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=10080
FRONTEND_ORIGIN=http://localhost:5173
PORT=8000
HOST=0.0.0.0
# Local mode needs no API key. Cloud LLM calls require an explicit opt-in.
ASSISTANT_LOCAL_ONLY=true
GEMINI_API_KEY=
TMDB_API_KEY=your-tmdb-api-key-here
ASSISTANT_RATE_LIMIT=20
ASSISTANT_GLOBAL_RATE_LIMIT=60
